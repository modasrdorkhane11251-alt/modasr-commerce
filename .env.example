# ============================================================
# MODASR Commerce - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# DATABASE
DATABASE_URL=postgresql://modasr:password@postgres:5432/modasr_commerce
SQLALCHEMY_ECHO=false

# REDIS
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# SECURITY
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256

# ENCRYPTION
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# TELEGRAM
TELEGRAM_BOT_TOKEN_MAIN=your-telegram-bot-token-here
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# OWNER/ADMIN
OWNER_TELEGRAM_ID=1355650097

# PAYMENT GATEWAYS
# Zarinpal
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_API_URL=https://api.zarinpal.com/rest/v1.6

# Pasargad (Pepco)
PASARGAD_MERCHANT_CODE=your-pasargad-code
PASARGAD_TERMINAL_CODE=your-terminal-code
PASARGAD_PRIVATE_KEY_PATH=/app/keys/pasargad_private.pem

# IranPay
IRANPAY_MERCHANT_ID=your-iranpay-merchant-id

# NowPayment (Crypto)
NOWPAYMENT_API_KEY=your-nowpayment-api-key

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@modasr.top

# APPLICATION
APP_NAME=MODASR Commerce
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# FRONTEND
NEXT_PUBLIC_API_URL=https://api.hosting.modasr.top
NEXT_PUBLIC_APP_URL=https://hosting.modasr.top
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=modasrbot

# CORS
CORS_ORIGINS=https://hosting.modasr.top,https://admin.hosting.modasr.top

# RATE LIMITING
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CELERY
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET_NAME=modasr-commerce
AWS_S3_REGION=us-east-1

# Cloudflare (Optional)
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# SENTRY (Optional - Error tracking)
SENTRY_DSN=

# DATADOG (Optional - Monitoring)
DATADOG_API_KEY=

# SLACK (Optional - Notifications)
SLACK_WEBHOOK_URL=

# Development only
ALLOW_CORS_ALL=false
